<?xml version="1.0" encoding="UTF-8"?>
<!-- The wlroots gamma control protocol (the parts display-dim uses), which
     Hyprland supports: a client sets one output's gamma ramps, kept while it
     holds the control. Copyright © 2015 Giulio camuffo, © 2018 Simon Ser;
     MIT licence, as in wlr-protocols. -->
<protocol name="wlr_gamma_control_unstable_v1">
  <interface name="zwlr_gamma_control_manager_v1" version="1">
    <request name="get_gamma_control">
      <arg name="id" type="new_id" interface="zwlr_gamma_control_v1"/>
      <arg name="output" type="object" interface="wl_output"/>
    </request>
    <request name="destroy" type="destructor"/>
  </interface>

  <interface name="zwlr_gamma_control_v1" version="1">
    <event name="gamma_size">
      <arg name="size" type="uint"/>
    </event>
    <request name="set_gamma">
      <arg name="fd" type="fd"/>
    </request>
    <event name="failed"/>
    <request name="destroy" type="destructor"/>
  </interface>
</protocol>
